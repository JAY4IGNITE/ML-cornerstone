# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Secrets / credentials (NEVER commit) ----
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key
secrets/

# ---- Data (large; acquired, not committed) ----
data/raw/**
data/processed/**
data/synthetic/**
!data/**/.gitkeep
!data/**/README.md

# ---- Trained model artifacts (regenerated by pipeline) ----
artifacts/**
!artifacts/.gitkeep
!artifacts/README.md

# ---- Reports (regenerated) ----
reports/**
!reports/.gitkeep

# ---- graphify knowledge-graph output (local tooling; regenerated) ----
graphify-out/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
